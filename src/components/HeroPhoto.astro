---
// Photo principale optimisée : AVIF + WebP (JPEG en repli), largeurs 640 / 1080 / 1500.
// Point focal 50% 32% (casque → guidon). Le bas de l'image reste hors cadre :
// impression partielle sur un sac, marque non validée [ACCORD CLIENT ?].
import { Picture } from 'astro:assets';
import paulo from '../assets/images/paulo-cargo.jpg';
---
<div class="hero-photo">
  <Picture
    src={paulo}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[640, 1080, 1500]}
    sizes="(min-width: 900px) 50vw, 100vw"
    alt="Paulo sur son vélo cargo chargé de sacs de livraison, dans une rue de Nice"
    loading="eager"
    fetchpriority="high"
    quality={55}
  />
</div>

<style>
  .hero-photo {
    background: var(--ocre);
    border-radius: var(--r-photo);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }
  @media (min-width: 900px) {
    .hero-photo { aspect-ratio: auto; height: 380px; }
  }
</style>
