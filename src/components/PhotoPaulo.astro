---
// Photo de Paulo (page « Qui est Paulo ») : AVIF + WebP (JPEG en repli), largeurs 640 / 1080 / 1500.
// Cadre ocre, arrondi 16px, point focal 50% 32%. Cadre carré pour garder le bas de l'image
// hors cadre : impression partielle sur un sac, marque non validée [ACCORD CLIENT ?].
import { Picture } from 'astro:assets';
import paulo from '../assets/images/paulo-cargo.jpg';
---
<div class="photo-paulo">
  <Picture
    src={paulo}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[640, 1080, 1500]}
    sizes="(min-width: 900px) 40vw, 100vw"
    alt="Paulo sur son vélo cargo chargé de sacs de livraison, dans une rue de Nice"
    quality={55}
  />
</div>

<style>
  .photo-paulo {
    background: var(--ocre);
    border-radius: var(--r-photo);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .photo-paulo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }
</style>
