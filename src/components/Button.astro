---
// Bouton principal (tomette) ou secondaire (contour volet).
// Rend un <a> si `href` est fourni, sinon un vrai <button>.
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary';
  size?: 'lg' | 'sm';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'>;

const { variant = 'primary', size = 'lg', href, type = 'button', class: extra, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', extra].filter(Boolean).join(' ');
---
{href ? (
  <a href={href} class={classes} {...rest}><slot /></a>
) : (
  <button type={type} class={classes} {...rest}><slot /></button>
)}
