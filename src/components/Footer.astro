---
// Pied de page : renvoi vers « Travailler avec nous », navigation, pages légales.
import Logo from './Logo.astro';
import { SITE, NAV, CTA, CONTACT, url } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="brand-line"><Logo height={32} /></p>
      <p class="small">{SITE.tagline}.</p>
      <p class="small">{SITE.zone}, {SITE.days.toLowerCase()}.</p>
    </div>

    <nav aria-labelledby="footer-nav-title">
      <h2 id="footer-nav-title" class="eyebrow">Le site</h2>
      <ul>
        <li><a href={url('/')}>Accueil</a></li>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={CTA.href}>{CTA.label}</a></li>
      </ul>
    </nav>

    <div class="site-footer__contact">
      <h2 class="eyebrow">Contact</h2>
      <ul class="small">
        <li>WhatsApp : <a href={CONTACT.whatsappUrl}>{CONTACT.whatsappLabel}</a></li>
        <li>Email : <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="container">
    <div class="site-footer__legal small">
      <p>© {year} {SITE.name}</p>
      <ul>
        <li><a href={url('/mentions-legales')}>Mentions légales</a></li>
        <li><a href={url('/confidentialite')}>Confidentialité</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--creme); border-top: 1px solid var(--trait); padding-top: var(--sp-7); }
  .site-footer__grid { display: grid; gap: var(--sp-6); }
  .site-footer__brand { display: grid; gap: var(--sp-2); color: var(--encre-douce); }
  .brand-line :global(img) { height: 32px; width: auto; }
  .site-footer h2 { font-family: var(--font-texte); margin-bottom: var(--sp-2); }
  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .site-footer__contact li { display: flex; flex-wrap: wrap; align-items: center; column-gap: 0.3em; }
  .site-footer__legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--sp-3);
    margin-top: var(--sp-6); padding-block: var(--sp-4);
    border-top: 1px solid var(--trait);
    color: var(--encre-douce);
  }
  .site-footer__legal ul { display: flex; flex-wrap: wrap; gap: var(--sp-4); }
  @media (min-width: 768px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__contact { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .site-footer__grid { grid-template-columns: 2fr 1fr 1.6fr; }
    .site-footer__contact { grid-column: auto; }
  }
</style>
