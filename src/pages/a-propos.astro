---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import PhotoPaul from '../components/PhotoPaul.astro';
import Marker from '../components/Marker.astro';
import FinalCta from '../components/FinalCta.astro';
---
<Base
  title="Les deux pédalent"
  description="Derrière Lou Tandem, il y a deux frères, Paul et Louis, livreurs à vélo cargo à Nice. Ils livrent les clients des commerces de proximité, du mardi au samedi."
>
  <PageIntro eyebrow="Les deux pédalent" title="Paul et Louis, deux frères à vélo cargo">
    <p>Lou Tandem, ce sont deux frères, Paul et Louis, livreurs à vélo cargo à Nice.</p>
  </PageIntro>

  <!-- 1. Présentation des deux frères — contenu À CONFIRMER -->
  <section class="section" aria-labelledby="freres-title" data-provisoire>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Les livreurs</p>
        <h2 id="freres-title">Frères de sang, frères de selle</h2>
      </div>
      <div class="grid grid--2">
        <article class="frere" aria-labelledby="paul-title">
          <PhotoPaul />
          <h3 id="paul-title">Paul</h3>
          <p><Marker text="[À CONFIRMER PAUL : présentation, parcours, ancrage niçois]" /></p>
        </article>
        <article class="frere" aria-labelledby="louis-title">
          <PhotoFrame label="Louis" ratio="1 / 1" />
          <h3 id="louis-title">Louis</h3>
          <p><Marker text="[À CONFIRMER LOUIS : présentation, parcours, ancrage niçois]" /></p>
        </article>
      </div>
    </div>
  </section>

  <!-- 2. Photos — à fournir -->
  <section class="section section--filet" aria-labelledby="photos-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">En images</p>
        <h2 id="photos-title">Le vélo et les tournées</h2>
        <p><Marker text="[À CONFIRMER PAUL : photos supplémentaires à fournir]" /></p>
      </div>
      <div class="grid grid--2">
        <PhotoFrame label="le vélo cargo seul" ratio="4 / 3" />
        <PhotoFrame label="une livraison en situation" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <!-- 3. Bloc final -->
  <FinalCta />
</Base>

<style>
  .frere { display: grid; gap: var(--sp-3); align-content: start; }
  .frere h3 { margin-top: var(--sp-2); }
  .section--filet { border-top: 1px solid var(--trait); }
</style>
