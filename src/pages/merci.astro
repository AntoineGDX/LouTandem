---
// Page de retour après l'envoi du formulaire (redirection configurée côté service de formulaires).
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import { url } from '../data/site';
---
<Base title="Demande envoyée" description="Votre demande a bien été envoyée à Lou Tandem." noindex>
  <PageIntro eyebrow="Demande envoyée" title="Merci, c'est bien reçu">
    <p>Nous vous recontactons pour parler de vos livraisons.</p>
  </PageIntro>
  <div class="section">
    <div class="container actions">
      <Button href={url('/')} variant="secondary">Retour à l'accueil</Button>
    </div>
  </div>
</Base>
