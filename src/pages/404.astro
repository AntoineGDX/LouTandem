---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
---
<Base title="Page introuvable" description="Cette page n'existe pas." noindex>
  <PageIntro eyebrow="Erreur 404" title="Cette page n'existe pas">
    <p>Le lien est peut-être ancien, ou l'adresse contient une faute de frappe.</p>
  </PageIntro>
  <div class="section">
    <div class="container actions">
      <Button href="/" variant="secondary">Retour à l'accueil</Button>
    </div>
  </div>
</Base>
