---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE } from '../data/site';

const faq = [
  {
    q: 'Combien de temps faut-il pour démarrer ?',
    a: "Aucun délai : dès que nous sommes d'accord, nous pouvons commencer.",
  },
  {
    q: 'Et si je dois annuler une livraison ?',
    a: 'Prévenez-nous par un appel ou un message sur WhatsApp.',
  },
  {
    q: 'Comment se passe la facturation ?',
    a: 'La facturation se fait à la course. Chaque mois, vous recevez une seule facture qui regroupe toutes les livraisons du mois.',
  },
  {
    q: 'Que se passe-t-il en cas de pluie ?',
    a: 'Nous livrons aussi par temps de pluie : le vélo cargo a une bâche qui protège la marchandise.',
  },
];
---
<Base
  title="Le service de livraison à vélo cargo"
  description="Lou Tandem récupère la marchandise chez votre commerce et la livre à vos clients à vélo cargo, dans Nice centre, du mardi au samedi. Organisation simple par WhatsApp, sur devis."
>
  <PageIntro eyebrow="Le service" title="Livraison à vélo cargo pour votre commerce">
    <p>Nous récupérons la marchandise chez vous et la livrons à vos clients, dans Nice centre, du mardi au samedi.</p>
  </PageIntro>

  <!-- 1. Ce que fait Lou Tandem -->
  <section class="section" aria-labelledby="quoi-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ce que fait Lou Tandem</p>
        <h2 id="quoi-title">De votre commerce à vos clients</h2>
      </div>
      <div class="prose">
        <p>
          Nous passons récupérer la marchandise dans votre commerce, puis nous la livrons chez vos clients.
          Ce sont surtout des professionnels, parfois des particuliers.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Comment on travaille ensemble -->
  <section class="section section--ocre" aria-labelledby="comment-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Comment on travaille ensemble</p>
        <h2 id="comment-title">Tout s'organise sur WhatsApp</h2>
      </div>
      <ul class="grid grid--3 points" role="list">
        <li class="card">Vous nous envoyez le nombre de livraisons à faire, en général la veille, parfois plus tôt.</li>
        <li class="card">Pour l'instant, nous travaillons avec des commerces réguliers. Les livraisons ponctuelles ou le jour même ne sont pas encore proposées, mais nous aimerions les ajouter.</li>
        <li class="card">Pas de réservation ni de paiement en ligne : on en parle directement.</li>
      </ul>
    </div>
  </section>

  <!-- 3. Ce qu'on peut transporter -->
  <section class="section" aria-labelledby="transport-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ce qu'on peut transporter</p>
        <h2 id="transport-title">Un vélo cargo, un espace de chargement à l'avant</h2>
      </div>
      <div class="prose">
        <p>
          Les livraisons se font en vélo cargo classique, avec un espace de chargement à l'avant.
          La capacité se raisonne en volume : on regarde ensemble ce que vous avez à livrer avant de démarrer.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Zone et jours -->
  <section class="section section--ocre" aria-labelledby="zone-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Zone et jours</p>
        <h2 id="zone-title">Où et quand</h2>
      </div>
      <div class="grid grid--2">
        <div class="card stack">
          <h3>Zone</h3>
          <p>{SITE.zone} : {SITE.quartiers}.</p>
          <p>D'autres quartiers proches sont possibles, au cas par cas.</p>
        </div>
        <div class="card stack">
          <h3>Jours</h3>
          <p>{SITE.days}.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Tarifs -->
  <section class="section" aria-labelledby="tarifs-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Tarifs</p>
        <h2 id="tarifs-title">Sur devis, selon vos besoins</h2>
      </div>
      <div class="prose">
        <p>Parlez-nous de vos livraisons : nous vous proposons un devis adapté.</p>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="section section--ocre" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="faq-title">Vos questions</h2>
      </div>
      <div class="faq">
        {faq.map((item) => (
          <details class="faq__item">
            <summary><span>{item.q}</span></summary>
            <div class="faq__answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Bloc final -->
  <FinalCta />
</Base>

<style>
  .stack { display: grid; gap: var(--sp-2); align-content: start; }
  .points { list-style: none; padding: 0; margin: 0; }

  .faq { display: grid; gap: var(--sp-3); max-width: 46rem; }
  .faq__item {
    background: var(--creme);
    border: 1px solid var(--trait);
    border-radius: var(--r-carte);
  }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4);
    min-height: 44px;
    padding: var(--sp-4) var(--sp-5);
    font-family: var(--font-titre); font-weight: var(--w-sub);
    font-size: var(--t-sub); line-height: var(--l-sub);
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: '';
    flex: none;
    width: 10px; height: 10px;
    border-right: 2px solid var(--volet); border-bottom: 2px solid var(--volet);
    transform: rotate(45deg) translateY(-3px);
    transition: transform .15s ease;
  }
  .faq__item[open] summary::after { transform: rotate(-135deg) translateY(-3px); }
  .faq__item summary:focus-visible { outline-offset: -3px; border-radius: var(--r-carte); }
  .faq__answer { padding: 0 var(--sp-5) var(--sp-5); }
</style>
