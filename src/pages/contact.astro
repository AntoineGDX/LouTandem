---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT } from '../data/site';
---
<Base
  title="Travailler avec nous"
  description="Vous êtes un commerce à Nice et vous voulez faire livrer vos clients à vélo cargo ? Écrivez-nous sur WhatsApp ou remplissez le formulaire de premier contact."
>
  <!-- 1. Introduction -->
  <PageIntro eyebrow="Travailler avec nous" title="Faisons connaissance">
    <p>Vous êtes un commerce à Nice et vous voulez faire livrer vos clients ?</p>
    <p>Écrivez-nous directement, ou laissez-nous quelques informations : nous vous recontactons pour en parler.</p>
  </PageIntro>

  <div class="section">
    <div class="container contact-grid">
      <!-- 2. Contact direct -->
      <section class="card direct" id="contact-direct" aria-labelledby="direct-title">
        <h2 id="direct-title" class="direct__title">Contact direct</h2>
        <p>Le plus simple : un message sur WhatsApp.</p>
        <div class="direct__actions">
          <Button href={CONTACT.whatsappUrl} variant="secondary">Écrire sur WhatsApp</Button>
        </div>
        <ul class="small direct__list">
          <li>WhatsApp : <a href={CONTACT.whatsappUrl}>{CONTACT.whatsappLabel}</a></li>
          <li>Email : <a class="direct__email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        </ul>
        <p class="small muted">Déjà client ? Vos commandes du quotidien continuent sur WhatsApp.</p>
      </section>

      <!-- 3. Formulaire de premier contact -->
      <section aria-labelledby="form-title" class="form-wrap">
        <h2 id="form-title">Formulaire de premier contact</h2>
        <ContactForm />

        <!-- 4. Après l'envoi -->
        <div class="after">
          <h3>Après l'envoi</h3>
          <p>Nous vous recontactons pour parler de vos livraisons.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .contact-grid { display: grid; gap: var(--sp-6); align-items: start; }
  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 1fr 2fr; gap: var(--sp-7); }
    .direct { position: sticky; top: var(--sp-5); }
  }

  .direct { display: grid; gap: var(--sp-4); background: var(--ocre); }
  .direct__title { font-size: var(--t-sub); line-height: var(--l-sub); font-weight: var(--w-sub); }
  .direct__actions { display: grid; gap: var(--sp-3); }
  .direct__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-1); }
  .direct__list li { display: flex; flex-wrap: wrap; align-items: center; column-gap: 0.3em; }
  .direct__list a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  /* Colonne étroite (2 colonnes dès 900px) : email plus petit pour tenir sur la ligne de « Email : » */
  @media (min-width: 900px) { .direct__email { font-size: 13px; } }
  @media (min-width: 900px) and (max-width: 979px) { .direct__email { font-size: 12px; } }

  .form-wrap { display: grid; gap: var(--sp-5); max-width: 44rem; }
  .after { display: grid; gap: var(--sp-2); padding-top: var(--sp-5); border-top: 1px solid var(--trait); }
</style>
