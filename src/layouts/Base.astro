---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, PRE_LAUNCH, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, noindex = false, ogImage } = Astro.props;
const fullTitle = title === SITE.name ? `${SITE.name} · ${SITE.tagline}` : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// Données structurées : uniquement les informations confirmées dans docs/brief.md.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  description: SITE.description,
  url: new URL(url('/'), Astro.site).href,
  areaServed: { '@type': 'City', name: SITE.city },
  address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: 'FR' },
  openingHours: 'Tu-Sa', // horaires [À CONFIRMER PAULO] : ajouter ex. 'Tu-Sa 08:00-18:00'
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || PRE_LAUNCH) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#A3472A" />
    <link rel="icon" href={url('/images/emblem-tomette.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
